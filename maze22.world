<?xml version="1.0" ?>
<sdf version="1.6">
<world name="maze_world">

  <include>
    <uri>model://sun</uri>
  </include>

  <include>
    <uri>model://ground_plane</uri>
  </include>

  <!-- 外围墙 -->

  <!-- 北墙分为两段，中心在 x=8 处留出小缺口（入口） -->
  <model name="wall_north_left">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>17.5 0.3 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>17.5 0.3 1</size></box></geometry>
      </visual>
    </link>
    <pose>-1.25 10 0.5 0 0 0</pose>
  </model>

  <model name="wall_north_right">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>1.5 0.3 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>1.5 0.3 1</size></box></geometry>
      </visual>
    </link>
    <pose>9.25 10 0.5 0 0 0</pose>
  </model>

  <!-- 南墙在 x=-8 处留出缺口（入口） -->
  <model name="wall_south_left">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>1.5 0.3 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>1.5 0.3 1</size></box></geometry>
      </visual>
    </link>
    <pose>-9.25 -10 0.5 0 0 0</pose>
  </model>

  <model name="wall_south_right">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>17.5 0.3 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>17.5 0.3 1</size></box></geometry>
      </visual>
    </link>
    <pose>1.25 -10 0.5 0 0 0</pose>
  </model>

  <!-- 东墙分段，y=8 处留缺口（与北墙的缺口在同一对角） -->
  <model name="wall_east_bottom">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.3 17.5 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.3 17.5 1</size></box></geometry>
      </visual>
    </link>
    <pose>10 -1.25 0.5 0 0 0</pose>
  </model>

  <model name="wall_east_top">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.3 1.5 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.3 1.5 1</size></box></geometry>
      </visual>
    </link>
    <pose>10 9.25 0.5 0 0 0</pose>
  </model>

  <!-- 西墙分段，y=-8 处留缺口（与南墙的缺口在同一对角） -->
  <model name="wall_west_bottom">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.3 1.5 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.3 1.5 1</size></box></geometry>
      </visual>
    </link>
    <pose>-10 -9.25 0.5 0 0 0</pose>
  </model>

  <model name="wall_west_top">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.3 17.5 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.3 17.5 1</size></box></geometry>
      </visual>
    </link>
    <pose>-10 1.25 0.5 0 0 0</pose>
  </model>


  <!-- 内部迷宫墙 -->

  <model name="maze_wall1">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>8 0.3 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>8 0.3 1</size></box></geometry>
      </visual>
    </link>
    <pose>-4 -5 0.5 0 0 0</pose>
  </model>


  <model name="maze_wall2">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.3 8 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.3 8 1</size></box></geometry>
      </visual>
    </link>
    <pose>2 -1 0.5 0 0 0</pose>
  </model>


  <model name="maze_wall3">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>8 0.3 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>8 0.3 1</size></box></geometry>
      </visual>
    </link>
    <pose>4 3 0.5 0 0 0</pose>
  </model>


  <model name="maze_wall4">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.3 8 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.3 8 1</size></box></geometry>
      </visual>
    </link>
    <pose>-3 5 0.5 0 0 0</pose>
  </model>


  <model name="maze_wall5">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>6 0.3 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>6 0.3 1</size></box></geometry>
      </visual>
    </link>
    <pose>-6 1 0.5 0 0 0</pose>
  </model>


  <model name="maze_wall6">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.3 6 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.3 6 1</size></box></geometry>
      </visual>
    </link>
    <pose>6 -4 0.5 0 0 0</pose>
  </model>


  <model name="maze_wall7">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>5 0.3 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>5 0.3 1</size></box></geometry>
      </visual>
    </link>
    <pose>1 7 0.5 0 0 0</pose>
  </model>

  <!-- 新增内部墙以增加复杂度 -->
  <model name="maze_wall8">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.3 6 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.3 6 1</size></box></geometry>
      </visual>
    </link>
    <pose>0 4 0.5 0 0 0</pose>
  </model>

  <model name="maze_wall9">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>4 0.3 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>4 0.3 1</size></box></geometry>
      </visual>
    </link>
    <pose>-2 2 0.5 0 0 0</pose>
  </model>

  <model name="maze_wall10">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.3 5 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.3 5 1</size></box></geometry>
      </visual>
    </link>
    <pose>3 -2 0.5 0 0 0</pose>
  </model>

  <model name="maze_wall11">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>3 0.3 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>3 0.3 1</size></box></geometry>
      </visual>
    </link>
    <pose>-5 -3 0.5 0 0 0</pose>
  </model>

  <model name="maze_wall12">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>2 0.3 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>2 0.3 1</size></box></geometry>
      </visual>
    </link>
    <pose>6 6 0.5 0 0 0</pose>
  </model>


</world>
</sdf>
