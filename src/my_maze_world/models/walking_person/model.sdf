<?xml version="1.0" ?>
<sdf version="1.6">
  <actor name="walking_person">
    <pose>0 0 0 0 0 0</pose>
    <scale>1 1 1</scale>
    <link name="link">
      <inertial>
        <mass>70.0</mass>
        <inertia>
          <ixx>5.0</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>5.0</iyy>
          <iyz>0.0</iyz>
          <izz>1.0</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.2</radius>
            <length>1.7</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://walking_person/meshes/walk.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
    <script>
      <loop>true</loop>
      <auto_start>true</auto_start>
      <animation name="walking">
        <filename>model://walking_person/meshes/walk.dae</filename>
        <scale>1</scale>
        <interpolate_x>true</interpolate_x>
      </animation>
    </script>
  </actor>
</sdf>
